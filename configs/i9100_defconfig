CONFIG_ARM=y
CONFIG_TEXT_BASE=0x48000000
CONFIG_EMBED_XNU=y
CONFIG_XNU_BLOB_LZ4=y
CONFIG_PAYLOAD_ENTRY=0x40001000
CONFIG_RAMDISK_ENTRY=0x42000000
CONFIG_RAMDISK_NO_COPY=y
CONFIG_COMPRESS_GZIP=n
CONFIG_LOGLEVEL=7
CONFIG_XNU_ENTRY_OFFSET=0xea8e0
# The shared cache is read from the SD card on this board, so do not
# spend ~154 MiB of boot.img on a copy nothing reads.
CONFIG_XNU_EMBED_CACHESLICE=n
CONFIG_XNU_PHYS_BASE=0x40000000
CONFIG_XNU_VIRT_BASE=0x80000000
CONFIG_XNU_MEMSIZE=0x3FE00000
CONFIG_XNU_FB_BASE=0x43E00000
CONFIG_XNU_FB_WIDTH=480
CONFIG_XNU_FB_HEIGHT=800
CONFIG_XNU_CMDLINE="-v keepsyms=1 kprintf=1 debug=0x14e i9100uart=1 ios7lab_vmabi=0 init=/sbin/launchd"
CONFIG_EXYNOS_4210=y
CONFIG_SAMSUNG_I9100=y
CONFIG_EARLYCON=y
CONFIG_EXYNOS_CDCACM4210=y
