CONFIG_TEXT_BASE=0x41000000
CONFIG_EMBED_XNU=y
# Raw embedded blob for bring-up smoke tests (see tools/ for the stub
# generator).  Flip to y once a real (LZ4-packed) XNU image exists.
CONFIG_XNU_BLOB_LZ4=n
CONFIG_PAYLOAD_ENTRY=0x40001000
CONFIG_RAMDISK_ENTRY=0x41000000
CONFIG_RAMDISK_NO_COPY=y
CONFIG_COMPRESS_GZIP=n
CONFIG_LOGLEVEL=7
# Mach-O images override this via LC_UNIXTHREAD scanning; 0 suits the
# bring-up stub whose entry is its first instruction.
CONFIG_XNU_ENTRY_OFFSET=0x0
# dyld_shared_cache_armv7 is read from the SD card like on j1xlte; keep
# the boot.img small.
CONFIG_XNU_EMBED_CACHESLICE=n
CONFIG_XNU_PHYS_BASE=0x40000000
CONFIG_XNU_VIRT_BASE=0x80000000
# Hand XNU 768 MiB of the 1 GiB DRAM; the top quarter stays clear of any
# TrustZone/S-Boot carveouts and the FIMD buffer (address TBD by probe).
CONFIG_XNU_MEMSIZE=0x30000000
CONFIG_XNU_FB_BASE=0x5E000000
CONFIG_XNU_FB_WIDTH=480
CONFIG_XNU_FB_HEIGHT=800
CONFIG_XNU_CMDLINE="-v keepsyms=1 kprintf=1 debug=0x14e init=/sbin/launchd"
CONFIG_EXYNOS_4210=y
CONFIG_SAMSUNG_I9100=y
CONFIG_EXYNOS_SDHCI4210=y
CONFIG_EXYNOS_SD_FAT=y
CONFIG_EXYNOS_SD_BOOT=y
CONFIG_EARLYCON=y
